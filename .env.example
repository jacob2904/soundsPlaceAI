# ---------------------------------------------------------------------------
# soundsPlaceAI / CineSFX secrets.
# Copy this file to `.env` and fill in ONLY the providers you intend to use.
# NEVER commit `.env`. Values here are read at runtime; nothing is hard-coded.
# ---------------------------------------------------------------------------

# ----- The "brain" (LLM) -----
# Set CINESFX_BRAIN in config.yaml to one of: gemini | openai | claude
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ----- Sound platforms -----
# Set CINESFX_SOUND_PROVIDER in config.yaml to one of:
#   epidemic | artlist | audiio | musicbed | soundly | freesound | local

# Epidemic Sound Partner Content API (requires a partnership agreement).
EPIDEMIC_API_KEY=
# A stable per-end-user id sent as x-partner-user-id (optional but recommended).
EPIDEMIC_PARTNER_USER_ID=

# Freesound (free; create an app at https://freesound.org/apiv2/apply/)
FREESOUND_API_KEY=

# Artlist Enterprise API (OAuth 2.0 Client Credentials). Issued by an Artlist
# account manager. NOTE: the Artlist API currently serves MUSIC (song) only —
# SFX are not yet exposed via the API. See docs/PROVIDERS.md.
ARTLIST_CLIENT_ID=
ARTLIST_CLIENT_SECRET=

# Audiio and Musicbed have NO public developer API (enterprise/bespoke only).
# Provide a base URL + token only if you have a partner integration; otherwise
# leave blank and pick a supported provider. See docs/PROVIDERS.md.
AUDIIO_API_BASE=
AUDIIO_API_TOKEN=
MUSICBED_API_BASE=
MUSICBED_API_TOKEN=

# Splice and Soundly are used via their LOCAL folders (no cloud key needed).
# Point config.yaml (splice.library_path / soundly.library_path) at those folders;
# Splice is auto-detected at ~/Splice or ~/Documents/Splice if omitted.

# ----- License (one-time, lifetime) -----
# Normally you activate in the panel or with `--activate <KEY>` (stored per-user).
# Optionally inject the key via the environment instead (e.g. a secret manager):
CINESFX_LICENSE_KEY=
# Vendors only: override the public verification key used to validate licenses.
CINESFX_LICENSE_PUBLIC_KEY=
